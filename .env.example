# Trusted server-only environment selection. Do not expose these as NEXT_PUBLIC_*.
ANTIFRAUD_NETWORK_KIND=demo
ANTIFRAUD_SOCIAL_DEMO_MODE=true
ANTIFRAUD_SOCIAL_DEPLOYMENT_STAGE=local
ANTIFRAUD_DEMO_RETENTION_DAYS=7
ANTIFRAUD_TEST_NETWORK_ENABLED=false
ANTIFRAUD_PRODUCTION_ENABLED=false

# BFF/service endpoints. Demo defaults to local services during local execution.
ANTIFRAUD_GATEWAY_URL=http://127.0.0.1:3700
ANTIFRAUD_GATEWAY_BEARER=replace-with-the-local-social-bff-token
ANTIFRAUD_ICA_URL=http://127.0.0.1:3920
ANTIFRAUD_TERMINOLOGY_URL=http://127.0.0.1:3930

# Local synthetic user-presence fixture only. Never use this value in Test Network.
ANTIFRAUD_DEMO_PIN=0426
